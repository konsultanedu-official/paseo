{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "{env:NINEROUTER_BASE_URL}",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "paseo-fast": {
          "name": "Paseo Fast",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "paseo-build": {
          "name": "Paseo Build",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "paseo-plan": {
          "name": "Paseo Plan",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "paseo-review": {
          "name": "Paseo Review",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "cx/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "reasoning": true
        },
        "cx/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "reasoning": true
        },
        "cx/gpt-5.6-sol-review": {
          "name": "GPT-5.6 Sol Review",
          "modalities": {
            "input": [
              "text",
