  },
  "agent": {
    "plan": {
      "model": "9router/paseo-plan"
    },
    "build": {
      "model": "9router/paseo-build"
    },
    "general": {
      "model": "9router/paseo-fast"
    },
    "explore": {
      "model": "9router/paseo-fast"
    },
    "review": {
      "description": "Read-only code review focused on correctness, security, performance, and maintainability.",
      "mode": "subagent",
      "model": "9router/paseo-review",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "skill": "allow"
  },
  "skills": {
    "paths": [
      "/home/paseo/.agents/skills"
    ]
  }
}
