{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "{env:NINEROUTER_BASE_URL}",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "cx/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "cx/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 372000,
            "output": 128000
          }
        },
        "cx/gpt-5.6-sol-review": {
          "name": "GPT-5.6 Sol Review",
          "limit": {
            "context": 372000,
            "output": 128000
          }
        },
        "ag/gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "ag/gemini-3.8-flash-low": {
          "name": "Gemini 3.8 Flash Low",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "ag/claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "ag/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "high-model": {
          "name": "High Model (Combo)"
        },
        "low-model": {
          "name": "Low Model (Combo)"
        },
        "free-model": {
          "name": "Free Model (Combo)"
        },
        "researcher": {
          "name": "Researcher (Combo)"
        },
        "gemini-pro": {
          "name": "Gemini Pro (Combo)"
        },
        "gemini-flash": {
          "name": "Gemini Flash (Combo)"
        },
        "claude-opus": {
          "name": "Claude Opus (Combo)"
        },
        "claude-sonnet": {
          "name": "Claude Sonnet (Combo)"
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (Combo)"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "9router/cx/gpt-6-astra"
    },
    "build": {
      "model": "9router/cx/gpt-5.6-sol"
    },
    "general": {
      "model": "9router/ag/gemini-3.8-flash-high"
    },
    "explore": {
      "model": "9router/ag/gemini-3.8-flash-low"
    },
    "plan-deep": {
      "description": "Deep planning and architecture mode for complex changes.",
      "mode": "primary",
      "model": "9router/ag/claude-opus-4-6-thinking",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "review": {
      "description": "Read-only code review focused on correctness, security, performance, and maintainability.",
      "mode": "subagent",
      "model": "9router/cx/gpt-5.6-sol-review",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "orchestrator": {
      "description": "Coordinates multi-stage delivery by delegating each phase to fresh Paseo agents. Must not modify source directly.",
      "mode": "primary",
      "model": "9router/cx/gpt-6-astra",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny",
        "task": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow"
        }
      }
    }
  }
}
